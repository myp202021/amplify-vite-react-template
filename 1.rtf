\f2\b0\fs26 \cf0 // Visualizaci\'f3n de campana de Gauss y dashboard\
import * as d3 from 'd3';\
\
// Crear visualizaci\'f3n de campana de Gauss\
function createGaussianGraph(container, score, national_mean = 50, std_dev = 15) \{\
    const width = container.clientWidth;\
    const height = 300;\
    const margin = \{ top: 20, right: 30, bottom: 40, left: 40 \};\
    \
    // Crear SVG\
    const svg = d3.select(container)\
        .append("svg")\
        .attr("width", width)\
        .attr("height", height);\
    \
    // Funci\'f3n de distribuci\'f3n normal\
    function gaussian(x, mean, std) \{\
        return Math.exp(-0.5 * Math.pow((x - mean) / std, 2)) / (std * Math.sqrt(2 * Math.PI));\
    \}\
    \
    // Escala X\
    const x = d3.scaleLinear()\
        .domain([0, 100])\
        .range([margin.left, width - margin.right]);\
    \
    // Generar puntos para la curva\
    const points = [];\
    for (let i = 0; i <= 100; i++) \{\
        points.push(\{\
            x: i,\
            y: gaussian(i, national_mean, std_dev)\
        \});\
    \}\
    \
    // Encontrar max y para escala Y\
    const maxY = d3.max(points, d => d.y);\
    \
    // Escala Y\
    const y = d3.scaleLinear()\
        .domain([0, maxY])\
        .range([height - margin.bottom, margin.top]);\
    \
    // Dibujar eje X\
    svg.append("g")\
        .attr("transform", `translate(0,$\{height - margin.bottom\})`)\
        .call(d3.axisBottom(x));\
    \
    // Crear l\'ednea\
    const line = d3.line()\
        .x(d => x(d.x))\
        .y(d => y(d.y))\
        .curve(d3.curveBasis);\
    \
    // Dibujar la curva\
    svg.append("path")\
        .datum(points)\
        .attr("fill", "none")\
        .attr("stroke", "#011638")\
        .attr("stroke-width", 2)\
        .attr("d", line);\
    \
    // A\'f1adir \'e1rea bajo la curva\
    svg.append("path")\
        .datum(points)\
        .attr("fill", "#011638")\
        .attr("fill-opacity", 0.2)\
        .attr("d", d3.area()\
            .x(d => x(d.x))\
            .y0(height - margin.bottom)\
            .y1(d => y(d.y))\
        );\
    \
    // Marcar la posici\'f3n del IMRD\
    svg.append("line")\
        .attr("x1", x(score))\
        .attr("y1", height - margin.bottom)\
        .attr("x2", x(score))\
        .attr("y2", margin.top)\
        .attr("stroke", "#FFD400")\
        .attr("stroke-width", 3)\
        .attr("stroke-dasharray", "5,5");\
    \
    // A\'f1adir etiqueta de score\
    svg.append("circle")\
        .attr("cx", x(score))\
        .attr("cy", margin.top)\
        .attr("r", 8)\
        .attr("fill", "#FFD400");\
    \
    svg.append("text")\
        .attr("x", x(score))\
        .attr("y", margin.top - 10)\
        .attr("text-anchor", "middle")\
        .attr("font-weight", "bold")\
        .text(`IMRD: $\{Math.round(score)\}`);\
    \
    // A\'f1adir etiquetas de rangos\
    const ranges = [\
        \{ min: 0, max: 20, text: "Muy negativa" \},\
        \{ min: 21, max: 40, text: "Negativa" \},\
        \{ min: 41, max: 60, text: "Neutra" \},\
        \{ min: 61, max: 80, text: "Positiva" \},\
        \{ min: 81, max: 100, text: "Excelente" \}\
    ];\
    \
    ranges.forEach(range => \{\
        const mid = (range.min + range.max) / 2;\
        svg.append("text")\
            .attr("x", x(mid))\
            .attr("y", height - 10)\
            .attr("text-anchor", "middle")\
            .attr("font-size", "10px")\
            .text(range.text);\
    \});\
\}\
