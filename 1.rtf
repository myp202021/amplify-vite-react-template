\f2\b0\fs26 \cf0 # Implementaci\'f3n del modelo IMRD\
class IMRDCalculator:\
    def __init__(self, national_mean=0.3, alpha=10):\
        self.national_mean = national_mean\
        self.alpha = alpha\
        \
    def calculate(self, brand_mentions):\
        # Suma ponderada del sentimiento\
        S_marca = sum([m['sentiment'] * m['weight'] for m in brand_mentions])\
        \
        # N\'famero total de menciones ponderadas\
        N_marca = sum([m['weight'] for m in brand_mentions])\
        \
        # C\'e1lculo del IMRD\
        imrd = ((S_marca + self.alpha * self.national_mean) / \
                (N_marca + self.alpha)) * 100\
        \
        # Ajustar al rango 0-100\
        imrd = max(0, min(100, imrd))\
        \
        return imrd\
