\f2\b0\fs26 \cf0 # Sistema de an\'e1lisis de sentimiento\
class SentimentAnalyzer:\
    def __init__(self):\
        # Cargar modelo pre-entrenado\
        self.sentiment_pipeline = pipeline("sentiment-analysis", \
                                          model="nlptown/bert-base-multilingual-uncased-sentiment")\
    \
    def analyze(self, text):\
        # An\'e1lisis b\'e1sico\
        result = self.sentiment_pipeline(text)[0]\
        score = float(result['label'].split()[0]) / 5.0  # Normalizar a 0-1\
        \
        # Convertir a la escala -1, 0, 1\
        if score < 0.4:\
            return -1  # Negativo\
        elif score > 0.6:\
            return 1   # Positivo\
        else:\
            return 0   # Neutral\
