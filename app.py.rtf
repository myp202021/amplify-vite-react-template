# Clase base para scrapers\
class BaseScraper:\
    def __init__(self, source_name, weight, sentiment_analyzer):\
        self.source_name = source_name\
        self.weight = weight\
        self.sentiment_analyzer = sentiment_analyzer\
        self.ua = UserAgent()\
    \
    async def search(self, brand_name, days=360):\
        """M\'e9todo base que debe ser implementado por las subclases"""\
        raise NotImplementedError("Las subclases deben implementar este m\'e9todo")\
    \
    def get_headers(self):\
        """Obtiene headers aleatorios para evitar detecci\'f3n de scraping"""\
        return \{\
            'User-Agent': self.ua.random,\
            'Accept': 'text/html,application/xhtml+xml,application/xml',\
            'Accept-Language': 'es-ES,es;q=0.9,en;q=0.8',\
            'Connection': 'keep-alive',\
        \}\
    \
    def save_mentions(self, conn, brand_name, mentions):\
        """Guarda las menciones en la base de datos"""\
        cursor = conn.cursor()\
        for m in mentions:\
            try:\
                cursor.execute("""\
                    INSERT INTO mentions (brand, source, url, text, date, sentiment, weight)\
                    VALUES (?, ?, ?, ?, ?, ?, ?)\
                """, (\
                    brand_name, \
                    self.source_name, \
                    m['url'], \
                    m['text'], \
                    m['date'], \
                    m['sentiment'], \
                    self.weight\
                ))\
            except Exception as e:\
                logger.error(f"Error al guardar menci\'f3n: \{e\}")\
        conn.commit()\
