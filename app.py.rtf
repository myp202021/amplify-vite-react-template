@app.post("/api/search", response_model=SearchResult)\
async def search_brand(search: BrandSearch, background_tasks: BackgroundTasks):\
    """Inicia una b\'fasqueda de marca"""\
    # Verificar l\'edmite de b\'fasquedas\
    if not await check_search_limit(search.email):\
        raise HTTPException(\
            status_code=429, \
            detail="Solo se permite 1 b\'fasqueda gratuita cada 24 horas"\
        )\
    \
    # Generar ID \'fanico para la tarea\
    task_id = str(uuid4())\
    \
    # Preparar datos de usuario\
    user_data = \{\
        'name': search.name,\
        'company': search.company,\
        'email': search.email,\
        'phone': search.phone\
    \}\
    \
    # Crear tarea as\'edncrona\
    task = asyncio.create_task(perform_search(search.brand, user_data))\
    active_tasks[task_id] = task\
    \
    # Configurar limpieza de tareas completadas despu\'e9s de un tiempo\
    background_tasks.add_task(cleanup_task, task_id, 60*60)  # Limpiar despu\'e9s de 1 hora\
    \
    return \{\
        "task_id": task_id,\
        "status": "processing",\
        "message": "Analizando menciones p\'fablicas. Esto puede tardar entre 2 y 8 minutos...",\
        "data": None\
    \}\
\
@app.get("/api/results/\{task_id\}", response_model=SearchResult)\
async def get_results(task_id: str):\
    """Obtiene los resultados de una b\'fasqueda en proceso"""\
    if task_id not in active_tasks:\
        raise HTTPException(status_code=404, detail="B\'fasqueda no encontrada")\
    \
    task = active_tasks[task_id]\
    \
    if task.done():\
        try:\
            result = task.result()\
            return \{\
                "task_id": task_id,\
                "status": "completed",\
                "message": "An\'e1lisis completado exitosamente",\
                "data": result\
            \}\
        except Exception as e:\
            logger.error(f"Error al obtener resultados: \{e\}")\
            return \{\
                "task_id": task_id,\
                "status": "error",\
                "message": f"Error en el an\'e1lisis: \{str(e)\}",\
                "data": None\
            \}\
    else:\
        return \{\
            "task_id": task_id,\
            "status": "processing",\
            "message": "Analizando menciones p\'fablicas. Esto puede tardar entre 2 y 8 minutos...",\
            "data": None\
        \}\
\
@app.get("/api/brands/ranking")\
async def get_brand_ranking():\
    """Obtiene el ranking de marcas seg\'fan su IMRD"""\
    conn = get_db_connection()\
    cursor = conn.cursor()\
    \
    cursor.execute("""\
        SELECT brand, imrd_score, mention_count, positive_ratio, negative_ratio, neutral_ratio\
        FROM brand_scores\
        ORDER BY imrd_score DESC\
        LIMIT 10\
    """)\
    \
    brands = []\
    for row in cursor.fetchall():\
        brands.append(\{\
            'brand': row['brand'],\
            'imrd_score': row['imrd_score'],\
            'mention_count': row['mention_count'],\
            'sentiment': \{\
                'positive': round(row['positive_ratio'] * 100, 2),\
                'neutral': round(row['neutral_ratio'] * 100, 2),\
                'negative': round(row['negative_ratio'] * 100, 2)\
            \},\
            'reputation_category': get_reputation_category(row['imrd_score'])\
        \})\
    \
    conn.close()\
    \
    return \{\
        "ranking": brands,\
        "timestamp": datetime.now().isoformat()\
    \}\
\
async def cleanup_task(task_id, delay_seconds):\
    """Limpia las tareas completadas despu\'e9s de un tiempo"""\
    await asyncio.sleep(delay_seconds)\
    if task_id in active_tasks:\
        del active_tasks[task_id]\
