# Funci\'f3n para comprobar si un usuario puede hacer una b\'fasqueda (l\'edmite de 1 cada 24h)\
async def check_search_limit(email):\
    """Verifica si el usuario ha alcanzado el l\'edmite de b\'fasquedas gratuitas"""\
    conn = get_db_connection()\
    cursor = conn.cursor()\
    \
    # Buscar usuario por email\
    cursor.execute("SELECT email, last_search FROM users WHERE email = ?", (email,))\
    user = cursor.fetchone()\
    \
    if user:\
        # Verificar \'faltima b\'fasqueda\
        last_search = datetime.fromisoformat(user['last_search']) if user['last_search'] else None\
        now = datetime.now()\
        \
        if last_search and (now - last_search).total_seconds() < 24 * 60 * 60:\
            conn.close()\
            return False\
    \
    conn.close()\
    return True\
\
# Funci\'f3n principal para realizar la b\'fasqueda de una marca\
async def perform_search(brand_name, user_data):\
    """Realiza la b\'fasqueda completa de una marca en todas las fuentes"""\
    logger.info(f"Iniciando b\'fasqueda para marca: \{brand_name\}")\
    \
    # Inicializar analizador de sentimiento\
    sentiment_analyzer = SentimentAnalyzer()\
    \
    # Obtener todas las fuentes de la base de datos\
    conn = get_db_connection()\
    cursor = conn.cursor()\
    cursor.execute("SELECT name, category, weight FROM sources")\
    sources = cursor.fetchall()\
    \
    # Registrar b\'fasqueda del usuario\
    try:\
        cursor.execute("""\
            INSERT INTO users (name, company, email, phone, last_search, search_count)\
            VALUES (?, ?, ?, ?, ?, 1)\
            ON CONFLICT(email) DO UPDATE SET\
                last_search = ?,\
                search_count = search_count + 1\
        """, (\
            user_data['name'], \
            user_data['company'], \
            user_data['email'], \
            user_data['phone'],\
            datetime.now().isoformat(),\
            datetime.now().isoformat()\
        ))\
        conn.commit()\
    except Exception as e:\
        logger.error(f"Error al registrar usuario: \{e\}")\
    \
    # Colecci\'f3n para todas las menciones\
    all_mentions = []\
    \
    # Buscar en cada fuente\
    for source in sources:\
        try:\
            scraper = create_scraper(source['name'], source['weight'], sentiment_analyzer)\
            mentions = await scraper.search(brand_name)\
            \
            # Analizar el sentimiento si no est\'e1 ya definido\
            for mention in mentions:\
                if 'sentiment' not in mention:\
                    mention['sentiment'] = sentiment_analyzer.analyze(mention['text'])\
            \
            # Guardar en base de datos\
            scraper.save_mentions(conn, brand_name, mentions)\
            \
            # A\'f1adir a la colecci\'f3n total\
            all_mentions.extend(mentions)\
            \
            # Simular tiempo de procesamiento (eliminar en producci\'f3n)\
            await asyncio.sleep(random.uniform(0.5, 2.0))\
            \
        except Exception as e:\
            logger.error(f"Error al buscar en \{source['name']\}: \{e\}")\
    \
    # Calcular el IMRD\
    calculator = IMRDCalculator()\
    imrd_score = calculator.calculate(all_mentions)\
    \
    # Calcular estad\'edsticas adicionales\
    total_mentions = len(all_mentions)\
    positive_mentions = sum(1 for m in all_mentions if m['sentiment'] > 0)\
    negative_mentions = sum(1 for m in all_mentions if m['sentiment'] < 0)\
    neutral_mentions = total_mentions - positive_mentions - negative_mentions\
    \
    positive_ratio = positive_mentions / total_mentions if total_mentions > 0 else 0\
    negative_ratio = negative_mentions / total_mentions if total_mentions > 0 else 0\
    neutral_ratio = neutral_mentions / total_mentions if total_mentions > 0 else 0\
    \
    # Guardar resultados en la base de datos\
    try:\
        cursor.execute("""\
            INSERT INTO brand_scores (brand, imrd_score, mention_count, positive_ratio, \
                                    negative_ratio, neutral_ratio)\
            VALUES (?, ?, ?, ?, ?, ?)\
        """, (\
            brand_name, imrd_score, total_mentions, positive_ratio, negative_ratio, neutral_ratio\
        ))\
        conn.commit()\
    except Exception as e:\
        logger.error(f"Error al guardar score de marca: \{e\}")\
    \
    conn.close()\
    \
    # Preparar resultados\
    result = \{\
        'brand': brand_name,\
        'imrd_score': round(imrd_score, 2),\
        'mention_count': total_mentions,\
        'sentiment': \{\
            'positive': round(positive_ratio * 100, 2),\
            'neutral': round(neutral_ratio * 100, 2),\
            'negative': round(negative_ratio * 100, 2)\
        \},\
        'mentions': [\
            \{\
                'source': m['source'] if 'source' in m else 'unknown',\
                'text': m['text'],\
                'date': m['date'],\
                'url': m['url'],\
                'sentiment': 'positivo' if m['sentiment'] > 0 else 'negativo' if m['sentiment'] < 0 else 'neutral'\
            \}\
            for m in sorted(all_mentions, key=lambda x: x['date'], reverse=True)[:20]  # \'daltimas 20 menciones\
        ],\
        'reputation_category': get_reputation_category(imrd_score),\
        'timestamp': datetime.now().isoformat()\
    \}\
    \
    logger.info(f"B\'fasqueda completada para \{brand_name\}. IMRD: \{imrd_score:.2f\}")\
    \
    return result\
\
def get_reputation_category(imrd_score):\
    """Determina la categor\'eda de reputaci\'f3n seg\'fan el IMRD"""\
    if imrd_score < 20:\
        return "Muy negativa"\
    elif imrd_score < 40:\
        return "Negativa"\
    elif imrd_score < 60:\
        return "Neutra"\
    elif imrd_score < 80:\
        return "Positiva"\
    else:\
        return "Excelente"\
