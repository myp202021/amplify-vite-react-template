    conn = get_db_connection()\
    cursor = conn.cursor()\
    \
    # Tabla de usuarios y b\'fasquedas\
    cursor.execute('''\
    CREATE TABLE IF NOT EXISTS users (\
        id INTEGER PRIMARY KEY AUTOINCREMENT,\
        name TEXT NOT NULL,\
