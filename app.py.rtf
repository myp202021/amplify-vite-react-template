# Factory para crear scrapers seg\'fan la fuente\
def create_scraper(source_name, weight, sentiment_analyzer):\
    """Crea el scraper adecuado seg\'fan la fuente"""\
    if source_name.lower() in ['twitter', 'x']:\
        return TwitterScraper(source_name, weight, sentiment_analyzer)\
    elif 'reclamos' in source_name.lower():\
        return ReclamosScraper(source_name, weight, sentiment_analyzer)\
    else:\
        # Por defecto, usar el scraper de noticias\
        return NewsScraper(source_name, weight, sentiment_analyzer)\
