# Clase para el an\'e1lisis de sentimiento\
class SentimentAnalyzer:\
    def __init__(self):\
        # En producci\'f3n, cargar un modelo pre-entrenado para espa\'f1ol/chileno\
        # Para el prototipo, usamos un modelo multiling\'fce b\'e1sico\
        try:\
            self.sentiment_pipeline = pipeline(\
                "sentiment-analysis",\
                model="nlptown/bert-base-multilingual-uncased-sentiment"\
            )\
            logger.info("Modelo de an\'e1lisis de sentimiento cargado correctamente")\
        except Exception as e:\
            logger.error(f"Error al cargar el modelo de sentimiento: \{e\}")\
            # Fallback a un analizador de sentimiento simple basado en reglas\
            self.sentiment_pipeline = None\
    \
    def analyze(self, text):\
        """Analiza el sentimiento del texto y devuelve -1 (negativo), 0 (neutral) o 1 (positivo)"""\
        if not text or len(text.strip()) == 0:\
            return 0\
        \
        try:\
            if self.sentiment_pipeline:\
                # Usar el modelo de ML\
                result = self.sentiment_pipeline(text[:512])[0]  # Limitar longitud\
                score = float(result['label'].split()[0]) / 5.0  # Normalizar a 0-1\
                \
                # Convertir a la escala -1, 0, 1\
                if score < 0.4:\
                    return -1  # Negativo\
                elif score > 0.6:\
                    return 1   # Positivo\
                else:\
                    return 0   # Neutral\
            else:\
                # Analizador simple basado en reglas\
                return self._simple_rule_analysis(text)\
        except Exception as e:\
            logger.error(f"Error en an\'e1lisis de sentimiento: \{e\}")\
            return 0  # En caso de error, devolver neutral\
    \
    def _simple_rule_analysis(self, text):\
        """Analizador simple basado en palabras clave para casos donde falla el modelo ML"""\
        text = text.lower()\
        \
        # Palabras positivas y negativas en espa\'f1ol (simplificado)\
        positive_words = ['bueno', 'excelente', 'genial', 'recomendable', 'positivo', \
                         'favorable', 'satisfecho', 'calidad', 'satisfacci\'f3n']\
        \
        negative_words = ['malo', 'p\'e9simo', 'terrible', 'deficiente', 'negativo', \
                         'desfavorable', 'insatisfecho', 'problema', 'queja', 'reclamo']\
        \
        pos_count = sum(1 for word in positive_words if word in text)\
        neg_count = sum(1 for word in negative_words if word in text)\
        \
        if pos_count > neg_count:\
            return 1\
        elif neg_count > pos_count:\
            return -1\
        else:\
            return 0\
