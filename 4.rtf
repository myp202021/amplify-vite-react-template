// Funci\'f3n para generar una distribuci\'f3n normal de Gauss\
const generateGaussianData = (mean = 50, stdDev = 15, points = 100) => \{\
  const data = [];\
  const min = 0;\
  const max = 100;\
  \
  for (let i = min; i <= max; i += (max - min) / points) \{\
    const x = i;\
    const y = (1 / (stdDev * Math.sqrt(2 * Math.PI))) * \
              Math.exp(-0.5 * Math.pow((x - mean) / stdDev, 2));\
    data.push(\{ x, y \});\
  \}\
  \
  return data;\
\};\
\
// Funci\'f3n para categorizar el IMRD\
const getIMRDCategory = (score) => \{\
  if (score < 20) return \{ category: 'Muy Negativa', color: 'bg-red-600', textColor: 'text-red-600' \};\
  if (score < 40) return \{ category: 'Negativa', color: 'bg-orange-500', textColor: 'text-orange-500' \};\
  if (score < 60) return \{ category: 'Neutra', color: 'bg-yellow-500', textColor: 'text-yellow-500' \};\
  if (score < 80) return \{ category: 'Positiva', color: 'bg-green-500', textColor: 'text-green-500' \};\
  return \{ category: 'Excelente', color: 'bg-green-700', textColor: 'text-green-700' \};\
\};\
